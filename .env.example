# OpenCode Mobile — optional environment variables
#
# ALL variables are optional. The app's core functionality (connect to a
# server, chat, sessions) works without any of them. Copy this file to
# `.env` only if you want to test telemetry / crash reporting while developing.
#
#   cp .env.example .env
#
# Variables prefixed EXPO_PUBLIC_ are embedded in the JS bundle at build time.

# Sentry crash reporting (opt-in at runtime via the consent dialog; the DSN is
# embedded at build time). Only needed for crash testing in dev builds.
EXPO_PUBLIC_SENTRY_DSN=

# PostHog analytics (opt-in at runtime). Only initialised after the user grants
# telemetry consent. HOST defaults to https://eu.i.posthog.com
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Chatwoot support widget. BASE_URL defaults to https://support.agentlabs.cc
EXPO_PUBLIC_CHATWOOT_INBOX_IDENTIFIER=
EXPO_PUBLIC_CHATWOOT_BASE_URL=https://support.agentlabs.cc
